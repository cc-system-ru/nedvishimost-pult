# ===== Пульт агентства: настройки сервера =====
# Скопируйте файл в .env и заполните. Файл .env не попадает в GitHub.

# Порт, на котором слушает приложение (Caddy проксирует на него)
PORT=3000

# Папка с базой и резервными копиями (по умолчанию ./data рядом с кодом)
# DATA_DIR=/opt/pult/data

# 1 — если сайт открывается по https (с доменом). Без домена оставьте 0.
COOKIE_SECURE=0

# 1 — загрузить демо-данные при первом запуске (удаляются кнопкой в пульте)
SEED_DEMO=1

# ===== ИИ (необязательно). Без этих строк пульт работает, ИИ-кнопки скрыты =====
# Вариант А: Anthropic (Claude). Проверьте доступность API для вашей компании.
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5-5
# LLM_MODEL_QUICK=claude-haiku-5-5

# Вариант Б: любой сервис с OpenAI-совместимым API (например, YandexGPT — сверьте адрес и модель в документации)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
# LLM_API_KEY=...
# LLM_AUTH_SCHEME=Api-Key
# LLM_MODEL=gpt://<ID_каталога>/yandexgpt/latest
